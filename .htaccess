Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /bethammi/

  # Redirect browser requests for PHP pages to their extensionless URL.
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]) [NC]
  RewriteRule ^(.+)\.php$ $1 [R=301,L,NE]

  # Leave real files and directories, including assets and explicit HTML pages, alone.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Prefer PHP when both PHP and HTML files share the same path.
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  # Otherwise serve a matching HTML page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
